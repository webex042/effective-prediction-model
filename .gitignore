# =============================================================================
# EPM .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# --- Virtual Environments ---
venv/
env/
.venv/
.env/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Data (large files) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md
# Dataset downloads/caches (data/raw/<id>/, data/raw/sklearn/, data/raw/uploads/) stay local.
data/verification_report.json

# --- Models (large files) ---
models/*
!models/.gitkeep
*.pt
*.pth
*.onnx
*.pkl
*.joblib
*.h5

# --- Experiment outputs ---
# Ignore local run noise, but DO track the structured experiment registry and
# the benchmark result JSONs so the dashboard/API can serve real data on deploy.
# (Loose experiments/*.json run-logs stay ignored — they embed local paths.)
experiments/*
!experiments/.gitkeep
!experiments/registry/
!experiments/registry/*
# Benchmark-runner results (src/benchmarking) — small JSON, served as run history
!experiments/benchmarks/
!experiments/benchmarks/*.json
benchmarks/*
!benchmarks/.gitkeep
!benchmarks/*.json

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Coverage ---
.coverage
htmlcov/
.pytest_cache/

# --- MyPy ---
.mypy_cache/

# --- Distribution ---
*.tar.gz
*.whl

# --- EPM Chat (standalone chatbot) runtime data: trained models, uploads, secrets ---
epm_chatbot/var/
epm_chatbot/.env
