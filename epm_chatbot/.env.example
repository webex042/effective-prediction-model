# EPM Chat — example configuration. Copy to .env (or set these in your host's
# environment / secrets manager). Every value is optional unless noted.

# --- Network -----------------------------------------------------------------
EPM_CHAT_HOST=127.0.0.1              # use 0.0.0.0 inside Docker / behind a reverse proxy
EPM_CHAT_PORT=8765
# Public URL of this chat service (used for CSP/CORS when behind a proxy)
EPM_CHAT_PUBLIC_ORIGIN=https://chat.example.com
# Websites allowed to embed the chat or call its API. Exact origins, comma-separated. No wildcards.
EPM_CHAT_ALLOWED_ORIGINS=https://www.your-chosen-site.com
EPM_CHAT_TRUST_PROXY=false           # true only behind a proxy that sets X-Forwarded-For/-Proto

# --- Security ----------------------------------------------------------------
# REQUIRED in production: >= 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
EPM_CHAT_SECRET_KEY=
EPM_CHAT_TOKEN_TTL_S=1800            # session token lifetime
EPM_CHAT_ACCESS_CODE=                # optional shared code users must enter (private deployments)
EPM_CHAT_API_KEYS=                   # optional comma-separated keys for server-to-server calls
EPM_CHAT_MAX_BODY_BYTES=65536
EPM_CHAT_MAX_UPLOAD_BYTES=5242880
EPM_CHAT_MAX_MESSAGE_CHARS=1000
EPM_CHAT_RATE_PER_MIN=40             # messages per session per minute
EPM_CHAT_RATE_IP_PER_MIN=120         # API requests per client IP per minute
EPM_CHAT_TRAIN_PER_HOUR=12           # training/comparison jobs per session per hour
EPM_CHAT_MAX_SESSIONS=500

# --- Models, data and jobs -----------------------------------------------------
EPM_CHAT_MODEL_DIR=./epm_chatbot/var/models
EPM_CHAT_UPLOAD_DIR=./epm_chatbot/var/uploads
EPM_CHAT_UPLOAD_TTL_S=3600           # uploads and chat-trained models are deleted after this
EPM_CHAT_JOB_WORKERS=1
EPM_CHAT_MAX_QUEUED_JOBS=4
EPM_CHAT_TRAIN_TIMEOUT_S=300         # hard limit; the training process is terminated
EPM_CHAT_PREDICT_TIMEOUT_S=20
EPM_CHAT_MAX_TRAIN_ROWS=20000
EPM_CHAT_ALLOW_DOWNLOADS=false       # let the bot download uncached public datasets (UCI/OpenML)
EPM_CHAT_ALLOW_NEURAL=true           # LSTM / GRU / Transformer / MLP training
EPM_CHAT_NEURAL_EPOCHS=25
# EPM_DATA_HOME=./data               # EPM's dataset cache (shared with the main project, read mostly)

# --- Optional LLM (server-side only; never sent to the browser) ---------------
EPM_CHAT_LLM_PROVIDER=               # "anthropic" to enable, empty to disable
EPM_CHAT_LLM_API_KEY=
EPM_CHAT_LLM_MODEL=                  # e.g. a current Claude model id from docs.claude.com
EPM_CHAT_LLM_TIMEOUT_S=20

EPM_CHAT_LOG_LEVEL=INFO
